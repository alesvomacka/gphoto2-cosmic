{
  "id": "io.github.alesvomacka.CameraImport",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "camera-import-applet",
  "branch": "stable",
  "finish-args": [
    "--require-version=1.16.0",
    "--socket=wayland",
    "--device=usb",
    "--device=dri",
    "--share=ipc",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--filesystem=xdg-config/cosmic:ro",
    "--filesystem=xdg-pictures:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.la",
    "/lib/libgphoto2/*/*.la",
    "/lib/libgphoto2_port/*/*.la",
    "/share/man",
    "/share/aclocal",
    "/share/doc",
    "/bin/gphoto2-config",
    "/bin/gphoto2-port-config"
  ],
  "modules": [
    {
      "name": "libusb",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static",
        "--disable-udev"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/libusb/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2",
          "sha256": "fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf"
        }
      ]
    },
    {
      "name": "libgphoto2",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static",
        "--disable-nls",
        "--disable-docs",
        "--with-camlibs=all"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/libgphoto2/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/gphoto/libgphoto2/releases/download/v2.5.34/libgphoto2-2.5.34.tar.xz",
          "sha256": "51993f5d9bfb6b4e5925cbbe5883085791bff6f81bcacb8ffe1b783ce76d586a"
        }
      ]
    },
    {
      "name": "popt",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static",
        "--disable-nls"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/popt/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-1.19.tar.gz",
          "sha256": "c25a4838fc8e4c1c8aacb8bd620edb3084a3d63bf8987fdad3ca2758c63240f9"
        }
      ]
    },
    {
      "name": "gphoto2",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-nls",
        "--without-cdk",
        "--without-readline"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/gphoto2/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/gphoto/gphoto2/releases/download/v2.5.32/gphoto2-2.5.32.tar.xz",
          "sha256": "be08a449bbed9613bc9db105997c4ba71410d41870496420359a99b37502c406"
        }
      ]
    },
    {
      "name": "camera-import-applet",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/camera-import-applet/cargo",
          "CARGO_BUILD_JOBS": "8"
        }
      },
      "build-commands": [
        "cargo build --release --offline --locked",
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "../dist/camera-import-applet-0.1.0.tar.gz",
          "sha256": "f8edc1a721c2b4b73fb79b4cc34f6c24b811c22e9aa6b715bf7239162c961cf6"
        }
      ]
    }
  ]
}
