<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.alesvomacka.CameraImport</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <url type="homepage">https://github.com/alesvomacka/gphoto2-cosmic</url>
  <url type="vcs-browser">https://github.com/alesvomacka/gphoto2-cosmic</url>
  <url type="bugtracker">https://github.com/alesvomacka/gphoto2-cosmic/issues</url>
  <developer id="io.github.alesvomacka"><name>Aleš Vomáčka</name></developer>
  <name>Camera Import Applet for COSMIC</name>
  <summary>Import photos from USB cameras in COSMIC</summary>
  <description>
    <p>A native COSMIC panel applet for importing photos, RAW files, videos, and sidecars from cameras supported by gphoto2.</p>
    <p>Choose a camera and destination, skip existing files, and optionally organize exports by date or camera folder. Follow progress with elapsed time, average speed, and an estimated finish time. Originals stay on the camera.</p>
    <p>A standalone window is also available for Niri and other Wayland desktops.</p>
  </description>
  <launchable type="desktop-id">io.github.alesvomacka.CameraImport.desktop</launchable>
  <icon type="stock">io.github.alesvomacka.CameraImport</icon>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>camera-import-applet</binary>
  </provides>
  <categories><category>Graphics</category><category>Photography</category></categories>
  <keywords><keyword>COSMIC</keyword><keyword>Camera</keyword><keyword>Photos</keyword><keyword>gphoto2</keyword></keywords>
  <supports><control>keyboard</control><control>pointing</control><control>touch</control></supports>
  <requires><display_length compare="ge">360</display_length></requires>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-27">
      <url type="details">https://github.com/alesvomacka/gphoto2-cosmic/releases/tag/v0.1.0</url>
      <description><p>Initial release with camera selection, safe imports, export layout options, and detailed progress.</p></description>
    </release>
  </releases>
</component>
